# ---------------------------------------------------------------------------
# هسته‌ی جنگو
# ---------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# برای SQLite (پیش‌فرض توسعه) این خط را خالی/حذف بگذارید.
# برای PostgreSQL در پروداکشن:
# DATABASE_URL=postgres://user:password@localhost:5432/ghalamino

# ---------------------------------------------------------------------------
# CORS (آدرس فرانت‌اندی که به این API وصل می‌شود)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# اگر فرانت‌اند جدا دارید، بعد از پرداخت کاربر به این آدرس (با کوئری‌پارامترهای
# order_number, status, ref_id) ریدایرکت می‌شود. خالی بگذارید تا پاسخ JSON مستقیم برگردد.
FRONTEND_ORDER_RESULT_URL=

ORDER_PENDING_PAYMENT_TIMEOUT_MINUTES=

# ---------------------------------------------------------------------------
#هزینه ارسال پست
# ---------------------------------------------------------------------------
#وزن پیش فرض محصولات اگه weight gram شون خالی باشه
DEFAULT_PRODUCT_WEIGHT_GRAMS=200
# نکته: جدول تعرفه پست پیشتاز و هزینه هر کیلوگرم اضافه دیگر از env خوانده نمی‌شوند؛
# از پنل ادمین (ShippingSettings / ShippingTariffRow) قابل تنظیم‌اند.
# اگر جمع قیمت کالاهای سفارش (تومان) به این مقدار برسد، ارسال رایگان می‌شود. صفر یعنی غیرفعال.
FREE_SHIPPING_THRESHOLD=0

# ---------------------------------------------------------------------------
# OTP و سرویس پیامک
# ---------------------------------------------------------------------------
OTP_CODE_LENGTH=5
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# 'console' برای توسعه (کد فقط در لاگ چاپ می‌شود) یا 'kavenegar' برای پروداکشن
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=ghalamino-otp
KAVENEGAR_ORDER_PAID_CUSTOMER_TEMPLATE=
KAVENEGAR_ORDER_PAID_ADMIN_TEMPLATE=
KAVENEGAR_ORDER_SHIPPED_TEMPLATE=

# ---------------------------------------------------------------------------
# درگاه‌های پرداخت
# ---------------------------------------------------------------------------
# آدرس پایه‌ی بک‌اند (بدون / انتهایی) - برای ساخت لینک صفحه‌ی واسط سیزپی/سپهر
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- سیزپی (SizPay) --- این ۵ مقدار پس از عقد قرارداد از پنل سیزپی دریافت می‌شود
SIZPAY_MERCHANT_ID=
SIZPAY_TERMINAL_ID=
SIZPAY_KEY=
SIZPAY_IV=
SIZPAY_SIGN_KEY=
SIZPAY_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payment/callback/sizpay/

# --- سپهر (بانک صادرات) --- پس از عقد قرارداد و ثبت IP سرور دریافت می‌شود
SEPEHR_TERMINAL_ID=
SEPEHR_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payment/callback/sepehr/
